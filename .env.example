# Sample environment configuration for Literature Mining LLM
# Copy this to .env and fill in your actual values

# LLM Provider Configuration
# Choose between 'gemini' or 'llamacpp'
LLM_PROVIDER=gemini

# Gemini API Configuration (if using gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Llama.cpp Configuration (if using llamacpp)
# These settings are for a local llama.cpp server running with OpenAI-compatible API
LLAMACPP_BASE_URL=http://localhost:8080/v1
LLAMACPP_MODEL=llama-model
LLAMACPP_TEMPERATURE=0.1
LLAMACPP_MAX_TOKENS=2048

# Database Configuration
POSTGRES_URL=postgresql://username:password@localhost:5432/database_name